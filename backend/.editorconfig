# Top-most config file in this tree
root = true

# Defaults for every file
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Configs and docs use 2-space indent
[*.{json,yml,yaml,md,csproj,props,targets,sln}]
indent_size = 2

# C# specific rules
[*.cs]

# Force file-scoped namespaces (one less indentation level than block-scoped)
csharp_style_namespace_declarations = file_scoped:error

# `var` when the type is obvious from the right-hand side
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Encourage expression-bodied members where it fits on one line
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion

# Modern null-handling
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning

# Prefer pattern matching over old-style type checks
csharp_style_prefer_pattern_matching = true:warning

# Sort System.* using directives before others (like ESLint sort-imports)
dotnet_sort_system_directives_first = true

# Async methods MUST end with "Async" — a community convention
dotnet_naming_rule.async_methods_end_in_async.severity = warning
dotnet_naming_rule.async_methods_end_in_async.symbols = any_async_method
dotnet_naming_rule.async_methods_end_in_async.style = end_in_async
dotnet_naming_symbols.any_async_method.applicable_kinds = method
dotnet_naming_symbols.any_async_method.required_modifiers = async
dotnet_naming_style.end_in_async.required_suffix = Async
dotnet_naming_style.end_in_async.capitalization = pascal_case

# === Generated code: EF Core migrations ===
# EF Core generates these files. We don't write them; we shouldn't lint them
# against our personal style rules. `generated_code = true` tells Roslyn
# analyzers to treat the file as auto-generated.

[**/Migrations/**.cs]
generated_code = true

# Allow the block-scoped namespace style EF's generator uses
csharp_style_namespace_declarations = file_scoped:silent

# Silence a handful of analyzer rules that fire on migration patterns
dotnet_diagnostic.IDE0161.severity = none   # Convert to file-scoped namespace
dotnet_diagnostic.CA1062.severity = none    # Validate arguments of public methods
dotnet_diagnostic.CA1822.severity = none    # Mark members as static