@'
# Build outputs
**/bin/
**/obj/
**/build/
**/dist/
**/.next/
**/out/

# Flutter
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages

# Node
**/node_modules/
**/.pnp.*
**/.yarn/

# IDE
.vs/
.idea/
*.user
*.suo
.vscode/launch.json

# Secrets — never commit these
**/*.env
**/*.env.local
**/secrets/
**/appsettings.Local.json

# OS junk
.DS_Store
Thumbs.db
'@ | Set-Content -Path .gitignore -Encoding UTF8